# Copiar a `.env` y completar los secretos. `.env` NO se versiona.

# --- Base de datos (PostgreSQL) ---
POSTGRES_USER=taller
# Obligatoria, sin valor por defecto
POSTGRES_PASSWORD=
POSTGRES_DB=taller_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# true para ver las consultas SQL en consola
SQL_ECHO=false

# --- Pool de conexiones ---
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- JWT ---
# Obligatoria, minimo 32 caracteres. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# 30 minutos = 1800 segundos
JWT_EXPIRE_MINUTES=30

# --- bcrypt ---
# En tests se puede bajar a 4 para acelerarlos
BCRYPT_ROUNDS=12
BCRYPT_MAX_CONCURRENCY=4

# --- Cookie ---
# true en produccion (HTTPS)
COOKIE_SECURE=false
